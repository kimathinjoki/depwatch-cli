# depwatch CLI settings. The CLI reads them from the environment, not from this file: export them in
# your shell (set -a; . ./.env; set +a) or set them as CI secrets and variables. Every one is optional:
# uncomment a line to set it. Never commit .env.

# The depwatch server and the part's project token, for scan, check, fix and deployed (instead of
# --server and --token, or `depwatch login`).
# DEPWATCH_SERVER=https://depwatch.example.com
# DEPWATCH_TOKEN=dwp_...

# Where `depwatch login` stores tokens; by default the user's config folder.
# DEPWATCH_CREDENTIALS=~/.config/depwatch/credentials.json

# Your own Anthropic key, for `depwatch check --assist` only; used from this machine, never sent to the
# depwatch server.
# ANTHROPIC_API_KEY=sk-ant-...

# For `depwatch fix` outside GitHub Actions (Actions sets these itself): the repository's token, with
# contents and pull requests write, and the repository.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPOSITORY=owner/name
# GITHUB_API_URL=https://api.github.com

# For `depwatch deployed` outside GitHub Actions, when --sha is not given.
# GITHUB_SHA=

# Any value turns colour off.
# NO_COLOR=1
