# watchdep CLI settings. The CLI reads them from the environment, not from this file: export them in
# your shell (set -a; . ./.env; set +a) or set them as CI secrets and variables. Every one is optional:
# uncomment a line to set it. Never commit .env.

# The watchdep server and the part's project token, for scan, check, fix and deployed (instead of
# --server and --token, or `watchdep login`).
# WATCHDEP_SERVER=https://watchdep.example.com
# WATCHDEP_TOKEN=wdp_...

# Where `watchdep login` stores tokens; by default the user's config folder.
# WATCHDEP_CREDENTIALS=~/.config/watchdep/credentials.json

# Your own provider key, for `watchdep check --assist` and `watchdep models` only; used from this machine,
# never sent to the watchdep server. Set one (or choose with --provider): Anthropic (or use your
# Anthropic login), Google Gemini, or OpenAI.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# For `watchdep fix` outside GitHub Actions (Actions sets these itself): the repository's token, with
# contents and pull requests write, and the repository.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPOSITORY=owner/name
# GITHUB_API_URL=https://api.github.com

# For `watchdep deployed` outside GitHub Actions, when --sha is not given.
# GITHUB_SHA=

# Any value turns colour off.
# NO_COLOR=1
